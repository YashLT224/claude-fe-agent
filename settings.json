{
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "50000"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:*.atlassian.net)",
      "WebFetch(domain:*.figma.com)",
      "WebFetch(domain:*.github.com)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(mkdir:*)",
      "mcp__atlassian__confluence_search",
      "Bash(python3 -c \"import sys,json; [print\\(f''''{x[\"\"type\"\"]:10} {x[\"\"name\"\"]}''''\\) for x in json.loads\\(sys.stdin.read\\(\\)\\)]\")",
      "Bash(python3 -c \"import sys,json; [print\\(x[''''name'''']\\) for x in json.loads\\(sys.stdin.read\\(\\)\\)]\")",
      "Bash(for f:*)",
      "Bash(do echo:*)",
      "Bash(done)",
      "Bash(for skill:*)",
      "Bash(for cmd:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(gh pr:*)",
      "Bash(echo $SHELL)",
      "Read(//Users/yashverma/**)",
      "Bash(nvm ls:*)",
      "Bash(nvm alias:*)",
      "Bash(rm -f app.log sdk/app.log .env browser_logs_*.txt)",
      "Bash(rm -rf screenshots/)"
    ],
    "additionalDirectories": [
      "/Users/yashverma/Desktop/Lambdatest Clients/accessibility/accessibility-sdk/.claude",
      "/Users/yashverma/Desktop/claude-fe-agent/skills",
      "/Users/yashverma/Desktop/Lambdatest Clients/accessibility/accessibility-sdk/.claude/workflow-state",
      "/Users/yashverma"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/yashverma/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "feature-forge@claude-team-plugins": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "plan-visualizer@claude-plan-visualizer": true
  },
  "extraKnownMarketplaces": {
    "claude-team-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/LambdatestIncPrivate/claude-team-plugins.git"
      }
    },
    "brainstorm-plan": {
      "source": {
        "source": "github",
        "repo": "thepushkarp/brainstorm-plan"
      }
    },
    "claude-plan-visualizer": {
      "source": {
        "source": "git",
        "url": "https://github.com/omril321/claude-plan-visualizer.git"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "mcpServers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://mcp.github.com/v1/mcp"
    }
  }
}
